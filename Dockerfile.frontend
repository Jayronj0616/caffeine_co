# Frontend-only Dockerfile for development with hot reload
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY client/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY client/ .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server with network access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
